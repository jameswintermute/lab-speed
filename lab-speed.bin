#!/usr/bin/env bash
# lab-speed — rapid lab setup utility
# v1.11.1 — May 2026 — James Wintermute
#
# Changes from v1.11.0:
#   - FIX: Options that need lab context (p, 1, 2, 3, 4, 5, r, 6, m, 8) used
#     to fall through to a generic "Lab username:" prompt on a fresh clone.
#     Now they detect the no-session state and redirect the user to Import
#     with a friendly explanation, instead of demanding manual credentials.
#     The dependency check (7) and clean up (9) still work on a fresh clone
#     since they have nothing to require.
#
# Changes from v1.11.0 (kept for reference):
#   - FIX: Import sometimes swapped the SSH user and the lab password when
#     the password happened to be alphanumeric (e.g. 7rxg9krr).
#   - NEW: p) Show password — displays for 10s, copies to clipboard.
#   - NEW: c) Refresh — explicit menu redraw.
#   - Clock: dropped seconds (now "00h 04m").
#   - Clean up: full session reset with confirmation.
#
# Changes from v1.9.0:
#   - Menu options renumbered to match visual reading order. Previously
#     numbers reflected the chronological order in which features were added
#     (Broadcast at 8, Health check at 9, etc), which clashed with the
#     section grouping introduced in v1.8. Now numbers count 1→9 top-to-bottom.
#
#     Old → New:  Broadcast 8→3,  URLs 6→4,  RSYNC again 3→5,
#                 Install SSH keys 4→6,  Dependency check 5→7,
#                 Health check 9→8,  Clean up 7→9.
#     Letters unchanged: i, r, m, q. GO! (1) and SSH (2) unchanged.
#
# Changes from v1.8.0:
#   - NEW: Lab time elapsed counter below the version banner. Starts when the
#     Import option succeeds. Goes yellow at 3h30m and red at 4h. Override
#     thresholds via LAB_WARN_SEC / LAB_LIMIT_SEC in local/credentials.txt.
#   - NEW: Repo URL shown at the bottom of every menu.
#   - Menu grouped into sections: setup / connect / files / keys / checks.
#
# Changes from v1.6.0:
#   - NEW: Option i = Import hosts — paste the lab credentials table from the
#     lab portal; lab-speed parses it (tab- or whitespace-separated), derives
#     the function name from each URL (cm1→CM, idx1→IDX1, shcd→SHC-Dep, …),
#     and writes local/hosts.csv. Also detects the SSH user and admin
#     password and offers to update local/credentials.txt. Existing files
#     are backed up to .bak-<timestamp> first.
#   - NEW: Option r = Retrieve — pull files from /tmp/lab-speed/ on each host
#     back to local/retrieved/<timestamp>/<func>/. Lets you grab logs,
#     configs, or output at the end of a lab. Supports per-host selection
#     ('a' for all, '3,7' for individual hosts, or '3-5' for a range).
#   - Internal IP now shown in: option 2 (SSH menu), option 9 (Health check),
#     option r (Retrieve). The hosts.csv format is unchanged.
#
# Changes from v1.5.0:
#   - NEW: Option m = Mesh SSH keys — sets up host-to-host SSH key auth.
#     hub-and-spoke (default) or full mesh modes.
#
# Changes from v1.4.0:
#   - NEW: Option 8 = Broadcast — tmux all-hosts session, type once hit all.
#   - NEW: Option 9 = Health check — parallel SSH; uptime/disk/mem/Splunk.
#
# Changes from v1.3.0 (kept for reference):
#   - FIX: line 310 unbound-variable crash on GO!/RSYNC.
#   - NEW: chmod -R 777 on remote target after rsync.
#   - NEW: Option 6 = URLs — lists host-url column from local/hosts.csv.
set -Eeuo pipefail

# ─────────────────────────────────── Colors ─────────────────────────────────
CLR_MAG="\033[35m"; CLR_GRN="\033[32m"; CLR_RED="\033[31m"
CLR_YEL="\033[33m"; CLR_CYN="\033[36m"; CLR_DIM="\033[2m"; CLR_RST="\033[0m"

# ─────────────────────────────────── Paths ──────────────────────────────────
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LOCAL_DIR="$ROOT_DIR/local"
LOGS_DIR="$ROOT_DIR/logs"
FILES_DIR="$ROOT_DIR/files-to-copy"
HOSTS_FILE="$LOCAL_DIR/hosts.csv"
CREDS_FILE="$LOCAL_DIR/credentials.txt"
LAB_START_FILE="$LOCAL_DIR/.lab-start"   # epoch timestamp of last successful Import
KNOWN_HOSTS_FILE="$ROOT_DIR/.known_hosts"
TARGET_DIR="/tmp/lab-speed"
REPO_URL="https://github.com/jameswintermute/lab-speed"
mkdir -p "$LOCAL_DIR" "$LOGS_DIR" "$FILES_DIR"

RUN_TAG="$(date +%Y%m%d-%H%M%S)-$$"
RUN_LOG="$LOGS_DIR/lab-speed-$RUN_TAG.log"

# ─────────────────────── SSH options (single definition) ────────────────────
# All ssh / rsync / ssh-copy-id calls use this array — change timeouts here only.
SSH_OPTS=(
  -o PreferredAuthentications=password
  -o PubkeyAuthentication=no
  -o NumberOfPasswordPrompts=1
  -o StrictHostKeyChecking=accept-new
  -o "UserKnownHostsFile=$KNOWN_HOSTS_FILE"
  -o ConnectTimeout=10
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=3
)

# ─────────────────────────────── ASCII banner ───────────────────────────────
# Compute elapsed time since the lab was imported (option i). Quiet if no
# .lab-start file, or if the file is implausibly old (>72h — almost certainly
# stale from a previous lab the user forgot to re-import).
#
# Colors:
#   <3h30m  → dim (neutral)
#   3h30m+  → yellow (approaching the typical 4h cut-off)
#   4h+     → red (past typical cut-off — lab may shut down any moment)
#
# Override the soft/hard thresholds via local/credentials.txt:
#   LAB_WARN_SEC=12600    # yellow at 3h30m   (default)
#   LAB_LIMIT_SEC=14400   # red    at 4h      (default)
lab_clock() {
  [[ -f "$LAB_START_FILE" ]] || return 0
  local start; start="$(cat "$LAB_START_FILE" 2>/dev/null)" || return 0
  [[ "$start" =~ ^[0-9]+$ ]] || return 0
  local now; now="$(date +%s)"
  local elapsed=$(( now - start ))
  (( elapsed < 0 )) && return 0       # clock skew — bail quietly
  (( elapsed > 259200 )) && return 0  # >72h — almost certainly stale

  # Threshold overrides — read straight from credentials.txt so they take
  # effect even before ensure_creds has run. Falls back to defaults if the
  # file doesn't exist or doesn't set them.
  local warn=12600   # 3h30m default
  local limit=14400  # 4h default
  if [[ -f "$CREDS_FILE" ]]; then
    local cw cl
    # `|| true` keeps a no-match grep from tripping `set -e + pipefail` in
    # the surrounding script — these overrides are optional.
    cw="$( { grep -E '^LAB_WARN_SEC='  "$CREDS_FILE" 2>/dev/null || true; } | tail -1 | cut -d= -f2- | tr -d '"'\''')"
    cl="$( { grep -E '^LAB_LIMIT_SEC=' "$CREDS_FILE" 2>/dev/null || true; } | tail -1 | cut -d= -f2- | tr -d '"'\''')"
    [[ "$cw" =~ ^[0-9]+$ ]] && warn="$cw"
    [[ "$cl" =~ ^[0-9]+$ ]] && limit="$cl"
  fi

  local h=$(( elapsed / 3600 ))
  local m=$(( (elapsed % 3600) / 60 ))

  local color="$CLR_DIM"
  local suffix=""
  if (( elapsed >= limit )); then
    color="$CLR_RED"
    suffix=" — past typical cut-off"
  elif (( elapsed >= warn )); then
    color="$CLR_YEL"
    suffix=" — approaching limit"
  fi

  # Resolution is minutes only — implying second-level accuracy would be
  # misleading since the clock only refreshes on menu redraw.
  printf "      %bLab time: %02dh %02dm%s%b\n" \
    "$color" "$h" "$m" "$suffix" "$CLR_RST"
  printf "      %b(elapsed since servers listed — press 'c' to refresh)%b\n" \
    "$CLR_DIM" "$CLR_RST"
}

header() {
  clear
  printf '\033]0;lab-speed\007'   # set terminal window/tab title
  printf "%b" "$CLR_MAG"
  printf "%s\n" " ╻  ┏━┓┏┓    ┏━┓┏━┓┏━╸┏━╸╺┳┓╻"
  printf "%s\n" " ┃  ┣━┫┣┻┓   ┗━┓┣━┛┣╸ ┣╸  ┃┃╹"
  printf "%s\n" " ┗━╸╹ ╹┗━┛   ┗━┛╹  ┗━╸┗━╸╺┻┛╹"
  printf "\n%s\n" "      A rapid lab setup utility"
  printf "\n%s\n" "      v1.11.1 - May 2026. James Wintermute"
  printf "%b\n" "$CLR_RST"
  lab_clock
}

# ───────────────────────────────── Logging ──────────────────────────────────
log()      { printf "%b[%s]%b %s\n"   "$CLR_CYN" "$1" "$CLR_RST" "$2" | tee -a "$RUN_LOG"; }
log_ok()   { printf "%b[OK]%b %s\n"   "$CLR_GRN"      "$CLR_RST" "$1" | tee -a "$RUN_LOG"; }
log_warn() { printf "%b[WARN]%b %s\n" "$CLR_YEL"      "$CLR_RST" "$1" | tee -a "$RUN_LOG"; }
log_err()  { printf "%b[ERR]%b %s\n"  "$CLR_RED"      "$CLR_RST" "$1" | tee -a "$RUN_LOG"; }
die()      { log_err "$1"; exit 1; }

# ──────────────────────────── Trim whitespace + CR ──────────────────────────
trim() {
  local s="$1"
  s="${s//$'\r'/}"
  s="${s#${s%%[![:space:]]*}}"
  s="${s%${s##*[![:space:]]}}"
  printf "%s" "$s"
}

# ──────────────────────────────── Progress bar ──────────────────────────────
progress_bar() {
  local cur="$1" total="$2" label="$3"
  local width=30
  local filled=$(( (cur * width) / (total == 0 ? 1 : total) ))
  local empty=$(( width - filled ))
  local bar
  bar="$(printf '%*s' "$filled" '' | tr ' ' '#')$(printf '%*s' "$empty" '' | tr ' ' '-')"
  printf "\r  [%s] %d/%d %s" "$bar" "$cur" "$total" "$label"
}

# ──────────────────────────────── Log rotation ──────────────────────────────
rotate_logs() {
  # Keep the 20 most recent log files; safely remove older ones via a bash loop
  # (avoids the xargs-with-empty-input edge case on some systems).
  local -a old_logs
  mapfile -t old_logs < <(ls -t "$LOGS_DIR"/lab-speed-*.log 2>/dev/null | tail -n +21)
  if (( ${#old_logs[@]} > 0 )); then
    rm -f -- "${old_logs[@]}"
  fi
}

# ──────────────────────────────── Credentials ───────────────────────────────
ensure_creds() {
  if [[ ! -f "$CREDS_FILE" ]]; then
    mkdir -p "$LOCAL_DIR"
    cat >"$CREDS_FILE" <<'CRED'
# lab-speed credentials (chmod 600)
username=""
password=""
SSHPASS=""   # must match password; read by sshpass -e
CRED
    chmod 600 "$CREDS_FILE"
  fi

  # shellcheck disable=SC1090
  set +u; source "$CREDS_FILE"; set -u

  username="${username:-}"
  password="${password:-}"
  SSHPASS="${SSHPASS:-}"

  if [[ -z "$username" || -z "$password" ]]; then
    log "INFO" "Credentials missing — prompting and saving to $CREDS_FILE"
    read -r -p "  Lab username: " username
    read -r -s -p "  Lab password: " password; echo
    SSHPASS="${SSHPASS:-$password}"
    {
      echo "# lab-speed credentials (chmod 600)"
      printf 'username=%q\n' "$username"
      printf 'password=%q\n' "$password"
      printf 'SSHPASS=%q\n'  "$SSHPASS"
    } >"$CREDS_FILE"
    chmod 600 "$CREDS_FILE"
  fi

  # Ensure SSHPASS is always set — sshpass -e reads this env var
  [[ -z "$SSHPASS" ]] && SSHPASS="$password"
  export SSHPASS
}

# ───────────────────────────────── Hosts file ───────────────────────────────
ensure_hosts() {
  if [[ ! -f "$HOSTS_FILE" ]]; then
    mkdir -p "$LOCAL_DIR"
    cat >"$HOSTS_FILE" <<'CSV'
host-url,external-ip,internal-ip,function
https://example-cm,1.2.3.4,10.0.0.1,Splunk-CM
CSV
  fi
}

# ─────────────────────────────── Lab-session guard ──────────────────────────
# Returns 0 if the lab session looks set up (either credentials or hosts.csv
# exists), so the caller can proceed.
#
# Returns non-zero on a "fresh clone — never imported" state, in which case
# it asks the user whether to jump straight to Import. If they say yes, it
# runs import_hosts inline; either way the caller should return to the menu
# rather than continue with its original action (the user came in via `p` or
# `1` thinking the lab was already loaded, and we have nothing to act on).
require_lab_session() {
  # If either real file exists, we have a session. The placeholder hosts.csv
  # planted by ensure_hosts is harmless — it only has example.com entries
  # and the user will replace it via Import or by hand.
  if [[ -f "$CREDS_FILE" ]] || [[ -f "$LAB_START_FILE" ]]; then
    return 0
  fi
  # No credentials, no lab clock — we are on a fresh clone.

  echo
  log_warn "No lab session yet — credentials and host details haven't been imported."
  log "INFO" "The fastest way to get started is option i (Import hosts from paste)."
  echo
  read -r -p "  Run Import now? (Y/n): " choice
  case "$choice" in
    n|N)
      log "INFO" "OK — pick option i when you have the lab credentials table to hand."
      return 1
      ;;
    *)
      import_hosts
      return 1   # Don't continue with the original option — let the user re-select
      ;;
  esac
}

# ─────────────────────────────── Dependency check ───────────────────────────
check_deps() {
  local missing=0
  for c in ssh rsync awk sed sshpass; do
    if ! command -v "$c" >/dev/null 2>&1; then
      log_err "Missing required dependency: $c"
      missing=1
    else
      log_ok "$c"
    fi
  done
  # ssh-copy-id is optional — only needed for option 6 (key install)
  if command -v ssh-copy-id >/dev/null 2>&1; then
    log_ok "ssh-copy-id (optional — key install available via option 6)"
  else
    log_warn "ssh-copy-id not found — option 6 (SSH key install) unavailable"
  fi
  # tmux is optional — only needed for option 3 (broadcast)
  if command -v tmux >/dev/null 2>&1; then
    log_ok "tmux (optional — broadcast available via option 3)"
  else
    log_warn "tmux not found — option 3 (Broadcast) unavailable"
  fi
  if (( missing )); then
    echo
    log "INFO" "Install (Ubuntu/Debian): sudo apt-get update && sudo apt-get install -y openssh-client rsync gawk sed sshpass"
    exit 1
  fi
}

# ───────────────────────────────── Read hosts ───────────────────────────────
# Finds external-ip and function columns by header name — not hardcoded position.
# Supports both external-ip and external_ip header variants.
read_hosts() {
  awk -F',' '
    NR==1 {
      for (i=1; i<=NF; i++) {
        gsub(/\r/, "", $i)
        h = tolower($i)
        if (h == "external-ip" || h == "external_ip") ip_col = i
        if (h == "function") fn_col = i
      }
    }
    NR>1 && ip_col && fn_col {
      gsub(/\r/, "", $ip_col)
      gsub(/\r/, "", $fn_col)
      if ($ip_col != "") print $ip_col "," $fn_col
    }
  ' "$HOSTS_FILE" | sed '/^[[:space:]]*$/d'
}

# ─────────────────────────────── Read hosts (full) ──────────────────────────
# Emits "external-ip,internal-ip,function" lines. Used by callers that want
# to display both IPs (option 2 SSH menu, option 8 Health check, option r
# Retrieve). Internal-ip column may be missing — emit "-" in that case so
# downstream callers can render a consistent layout.
read_hosts_full() {
  awk -F',' '
    NR==1 {
      for (i=1; i<=NF; i++) {
        gsub(/\r/, "", $i)
        h = tolower($i)
        if (h == "external-ip" || h == "external_ip") ext_col = i
        if (h == "internal-ip" || h == "internal_ip") int_col = i
        if (h == "function") fn_col = i
      }
    }
    NR>1 && ext_col && fn_col {
      gsub(/\r/, "", $ext_col)
      gsub(/\r/, "", $fn_col)
      ic = "-"
      if (int_col) { gsub(/\r/, "", $int_col); if ($int_col != "") ic = $int_col }
      if ($ext_col != "") print $ext_col "," ic "," $fn_col
    }
  ' "$HOSTS_FILE" | sed '/^[[:space:]]*$/d'
}

# ───────────────────────────────── Read URLs ────────────────────────────────
# Emits "url,function" lines. Column 1 (host-url) is paired with the function
# column so we can show a friendly label next to each URL.
read_urls() {
  awk -F',' '
    NR==1 {
      for (i=1; i<=NF; i++) {
        gsub(/\r/, "", $i)
        h = tolower($i)
        if (h == "host-url" || h == "host_url" || h == "url") url_col = i
        if (h == "function") fn_col = i
      }
    }
    NR>1 && url_col {
      gsub(/\r/, "", $url_col)
      if (fn_col) gsub(/\r/, "", $fn_col)
      if ($url_col != "") print $url_col "," (fn_col ? $fn_col : "")
    }
  ' "$HOSTS_FILE" | sed '/^[[:space:]]*$/d'
}

# ─────────────────────────────────── List URLs ──────────────────────────────
# Pretty-prints column 1 of local/hosts.csv (the host-url column) numbered and
# labelled by function — handy for jumping to lab web UIs in a browser.
list_urls() {
  require_lab_session || return 0
  ensure_hosts

  mapfile -t rows < <(read_urls)
  local total="${#rows[@]}"
  if (( total == 0 )); then
    log_warn "No URLs found in $HOSTS_FILE (expected a 'host-url' column)."
    return 0
  fi

  echo
  printf "  %s\n" "Lab URLs (from $HOSTS_FILE):"
  echo
  local i=0 line url func
  for line in "${rows[@]}"; do
    i=$(( i + 1 ))
    IFS=',' read -r url func <<<"$line"
    url="$(trim "$url")"; func="$(trim "$func")"
    printf "  %2d) %-8s %s\n" "$i" "${func:-—}" "$url"
  done
  echo
}

# ──────────────────────────── Rsync to one host ─────────────────────────────
rsync_to_host() {
  local ip="$1" func="$2"
  ip="$(trim "$ip")"; func="$(trim "$func")"

  if [[ -z "$ip" ]]; then
    log_warn "Skipping ${func}: empty IP address"
    return 1
  fi
  if [[ ! "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    log_warn "${func}: '$ip' doesn't look like an IPv4 address — attempting anyway"
  fi

  # Build rsync -e argument with properly shell-quoted SSH options.
  # printf %q ensures paths with spaces (e.g. UserKnownHostsFile) are handled correctly.
  # -z (compression) is intentionally omitted — it adds CPU overhead on both sides and
  # is a net slowdown on the high-bandwidth links typical of cloud lab environments.
  local ssh_e
  ssh_e="ssh$(printf ' %q' "${SSH_OPTS[@]}")"

  if sshpass -e rsync -a --delete --mkpath \
      -e "$ssh_e" \
      "$FILES_DIR/" "${username}@${ip}:$TARGET_DIR/" 2>/dev/null; then
    # Loosen permissions for lab use — students may need to read/edit/execute
    # everything without fighting permissions. Best-effort: rsync success is
    # what we report on; chmod failure is logged but doesn't fail the host.
    sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${ip}" \
      "chmod -R 777 '$TARGET_DIR'" 2>/dev/null || \
      log_warn "${func} (${ip}): rsync OK but chmod 777 failed"
    return 0
  fi

  # Fallback for rsync < 3.2.3 (no --mkpath): create remote directory first,
  # then rsync. Costs one extra SSH connection per host but is fully compatible.
  sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${ip}" \
    "mkdir -p '$TARGET_DIR'" 2>/dev/null || return 1

  if sshpass -e rsync -a --delete \
      -e "$ssh_e" \
      "$FILES_DIR/" "${username}@${ip}:$TARGET_DIR/" 2>/dev/null; then
    sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${ip}" \
      "chmod -R 777 '$TARGET_DIR'" 2>/dev/null || \
      log_warn "${func} (${ip}): rsync OK but chmod 777 failed"
    return 0
  fi
  return 1
}

# ────────────────── Parallel provision (GO! and RSYNC again) ────────────────
# Runs all rsync jobs concurrently. Results written to a temp dir so the
# summary is accurate even with parallel output.
_run_parallel() {
  local label="$1"
  mapfile -t hosts < <(read_hosts)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  log "INFO" "$label starting — provisioning $total host(s) in parallel (→ $TARGET_DIR)"
  log "INFO" "Files on remote hosts will be chmod -R 777 for unrestricted lab access."

  local tmpdir; tmpdir="$(mktemp -d)"
  # NOTE: double-quoted trap — $tmpdir must be expanded at trap-definition time.
  # If single-quoted, the expansion is deferred until the trap fires, by which
  # point this `local` has gone out of scope and `set -u` will abort with
  # "tmpdir: unbound variable" in the caller. (This bit us in v1.3.0.)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" RETURN

  local t_start; t_start="$(date +%s)"

  # Launch all rsync jobs in the background.
  # Redirect subshell stdout/stderr to /dev/null — keeps the progress bar clean.
  # Log writes (via tee) still land in $RUN_LOG even with stdout suppressed.
  local pids=() line ip func
  for line in "${hosts[@]}"; do
    IFS=',' read -r ip func <<<"$line"
    ip="$(trim "$ip")"; func="$(trim "$func")"
    (
      if rsync_to_host "$ip" "$func"; then
        printf "ok:%s:%s\n"   "$func" "$ip" >"$tmpdir/${func//\//_}.result"
      else
        printf "fail:%s:%s\n" "$func" "$ip" >"$tmpdir/${func//\//_}.result"
      fi
    ) >/dev/null 2>&1 &
    pids+=($!)
  done

  # Poll for completion.
  # shopt nullglob is scoped to this block: *.result won't expand to a literal
  # string when no files exist yet, preventing spurious loop iterations.
  shopt -s nullglob
  local done_count=0
  while (( done_count < total )); do
    local result_files=("$tmpdir"/*.result)
    done_count="${#result_files[@]}"
    progress_bar "$done_count" "$total" "syncing..."
    sleep 0.25
  done
  shopt -u nullglob
  echo

  # Reap all background jobs cleanly
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  local t_end elapsed
  t_end="$(date +%s)"; elapsed=$(( t_end - t_start ))

  # Tally results and surface any per-host failures
  local ok=0 fail=0 result_file
  for result_file in "$tmpdir"/*.result; do
    [[ -f "$result_file" ]] || continue
    local result; result="$(cat "$result_file")"
    case "$result" in
      ok:*)   ok=$(( ok + 1 )) ;;
      fail:*) fail=$(( fail + 1 ))
              local fhost; fhost="${result#fail:}"
              log_warn "${fhost%%:*} (${fhost##*:}): rsync failed — check credentials / SSH access" ;;
    esac
  done

  if (( fail == 0 )); then
    log_ok "$label complete — ${ok}/${total} hosts ready in ${elapsed}s."
  else
    log_warn "$label finished — ${ok}/${total} OK, ${fail} failed in ${elapsed}s. See: $RUN_LOG"
  fi
}

go_run() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds
  check_deps
  _run_parallel "GO"
  log "INFO" "Next: choose option 2 to open SSH sessions."
}

rsync_only() {
  require_lab_session || return 0
  # Skips ensure_creds / check_deps when GO! has already been run this session.
  # Falls back gracefully if the user jumps straight to option 5.
  [[ -z "${SSHPASS:-}" ]] && ensure_creds
  ensure_hosts
  _run_parallel "RSYNC"
}

# ──────────────────────────── SSH key installation ──────────────────────────
# Installs your local SSH public key to all hosts in parallel via ssh-copy-id.
# After this, SSH connections no longer require sshpass (use option 2 normally
# — it will fall through to key auth automatically once sshpass is unavailable).
install_ssh_keys() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds

  if ! command -v ssh-copy-id >/dev/null 2>&1; then
    log_err "ssh-copy-id not found. Install: sudo apt-get install -y openssh-client"
    return 1
  fi

  # Find or generate a local keypair
  local key_file="$HOME/.ssh/id_rsa"
  if [[ ! -f "$key_file" ]]; then
    log "INFO" "No SSH key at $key_file — generating RSA 4096 keypair"
    ssh-keygen -t rsa -b 4096 -N "" -f "$key_file" -q
    log_ok "Keypair created: $key_file"
  fi
  local pub_key="${key_file}.pub"
  [[ -f "$pub_key" ]] || die "Public key not found: $pub_key"

  mapfile -t hosts < <(read_hosts)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  log "INFO" "Installing SSH public key to $total host(s) in parallel..."

  local tmpdir; tmpdir="$(mktemp -d)"
  # See _run_parallel for why this trap is double-quoted, not single-quoted.
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" RETURN

  local pids=() line ip func
  for line in "${hosts[@]}"; do
    IFS=',' read -r ip func <<<"$line"
    ip="$(trim "$ip")"; func="$(trim "$func")"
    (
      # -f forces copy even if the key is already present (idempotent)
      if sshpass -e ssh-copy-id -f -i "$pub_key" \
          "${SSH_OPTS[@]}" "${username}@${ip}"; then
        printf "ok:%s:%s\n"   "$func" "$ip" >"$tmpdir/${func//\//_}.result"
      else
        printf "fail:%s:%s\n" "$func" "$ip" >"$tmpdir/${func//\//_}.result"
      fi
    ) >/dev/null 2>&1 &
    pids+=($!)
  done

  shopt -s nullglob
  local done_count=0
  while (( done_count < total )); do
    local result_files=("$tmpdir"/*.result)
    done_count="${#result_files[@]}"
    progress_bar "$done_count" "$total" "copying keys..."
    sleep 0.25
  done
  shopt -u nullglob
  echo

  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  local ok=0 fail=0 result_file
  for result_file in "$tmpdir"/*.result; do
    [[ -f "$result_file" ]] || continue
    local result; result="$(cat "$result_file")"
    case "$result" in
      ok:*)   ok=$(( ok + 1 )) ;;
      fail:*) fail=$(( fail + 1 ))
              local fhost; fhost="${result#fail:}"
              log_warn "${fhost%%:*} (${fhost##*:}): key install failed" ;;
    esac
  done

  if (( fail == 0 )); then
    log_ok "SSH key installed on ${ok}/${total} hosts."
  else
    log_warn "Key install — ${ok}/${total} OK, ${fail} failed."
  fi
}

# ────────────────────────────── Terminal launcher ───────────────────────────
# Receives a path to a self-contained bash script and opens it in the first
# available GUI terminal emulator.
# Passing a script file (rather than a command string) avoids the nested-quote
# fragility that broke the previous bash -lc "..." approach.
# Returns 1 if no supported GUI terminal is found.
open_ssh_terminal() {
  local title="$1" script="$2"

  if command -v gnome-terminal >/dev/null 2>&1; then
    # Try with --title (older gnome-terminal); fall back without it (newer builds
    # dropped the flag — they return non-zero on unrecognised options).
    { gnome-terminal --title="$title" -- bash "$script" 2>/dev/null \
        || gnome-terminal -- bash "$script" 2>/dev/null; } &
    return 0
  fi
  if command -v xterm >/dev/null 2>&1; then
    xterm -T "$title" -e bash "$script" >/dev/null 2>&1 &
    return 0
  fi
  if command -v konsole >/dev/null 2>&1; then
    konsole -p tabtitle="$title" -e bash "$script" >/dev/null 2>&1 &
    return 0
  fi
  if command -v alacritty >/dev/null 2>&1; then
    alacritty --title "$title" -e bash "$script" >/dev/null 2>&1 &
    return 0
  fi
  if command -v wezterm >/dev/null 2>&1; then
    wezterm start --class "$title" bash "$script" >/dev/null 2>&1 &
    return 0
  fi
  if command -v x-terminal-emulator >/dev/null 2>&1; then
    x-terminal-emulator -T "$title" -e bash "$script" >/dev/null 2>&1 &
    return 0
  fi

  rm -f "$script"   # clean up — script won't self-delete if never run
  return 1
}

# ─────────────────────────────────── SSH menu ───────────────────────────────
ssh_menu() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds   # ensures SSHPASS is exported

  mapfile -t hosts < <(read_hosts_full)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  echo
  printf "  %s\n" "  #  Function               External IP      Internal IP"
  printf "  %s\n" "  -  --------               -----------      -----------"
  local i=0 line ext_ip int_ip func
  for line in "${hosts[@]}"; do
    i=$(( i + 1 ))
    IFS=',' read -r ext_ip int_ip func <<<"$line"
    ext_ip="$(trim "$ext_ip")"; int_ip="$(trim "$int_ip")"; func="$(trim "$func")"
    printf "  %2d) %-22s %-16s %s\n" "$i" "${func:-HOST}" "$ext_ip" "${int_ip:--}"
  done

  echo
  read -r -p "  Select host number (or q): " sel
  [[ "$sel" == "q" || "$sel" == "Q" ]] && return 0
  [[ "$sel" =~ ^[0-9]+$ ]] || { log_warn "Invalid selection"; return 0; }
  (( sel >= 1 && sel <= total )) || { log_warn "Selection out of range"; return 0; }

  IFS=',' read -r ext_ip int_ip func <<<"${hosts[$(( sel - 1 ))]}"
  ext_ip="$(trim "$ext_ip")"; int_ip="$(trim "$int_ip")"; func="$(trim "$func")"
  local ip="$ext_ip"

  # Write a self-contained, self-deleting SSH session script.
  # Using a temp file avoids all nested-quoting issues when passing the SSH
  # command (with its many -o options) to a GUI terminal emulator.
  local tmp_script; tmp_script="$(mktemp --suffix=.sh)"
  chmod 700 "$tmp_script"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'export SSHPASS=%q\n' "$SSHPASS"
    # Set the new terminal window's title to the host function name
    printf 'printf "\\033]0;%s\\007"\n' "${func:-HOST}"
    printf 'sshpass -e ssh'
    printf ' %q' "${SSH_OPTS[@]}"
    printf ' %q\n' "${username}@${ip}"
    printf 'echo\n'
    printf "printf '[lab-speed] session ended\\\\n'\n"
    printf "read -r -p 'Press Enter to close...' _\n"
    printf 'rm -f -- %q\n' "$tmp_script"
  } >"$tmp_script"

  # Update this terminal's title to reflect the active host
  printf '\033]0;%s\007' "${func:-HOST}"

  if open_ssh_terminal "${func:-HOST}" "$tmp_script"; then
    log_ok "Opened SSH in a new terminal: ${func:-HOST} ($ip)"
    printf '\033]0;lab-speed\007'   # restore title
    return 0
  fi

  # No GUI terminal available — open SSH directly in this window.
  # Direct array call: no eval, no shell injection risk.
  log "INFO" "No GUI terminal found — opening SSH in this window."
  sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${ip}"
  printf '\033]0;lab-speed\007'
  rm -f "$tmp_script"
}

# ──────────────────────────── Broadcast (tmux) ──────────────────────────────
# Opens tmux in a new GUI terminal with one pane per host, all running ssh.
# synchronize-panes is ON by default — keystrokes hit every host at once.
# Toggle off inside tmux with:  Ctrl-b :setw synchronize-panes off
# Detach with Ctrl-b d, kill the session with Ctrl-b : kill-session.
broadcast_tmux() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds

  if ! command -v tmux >/dev/null 2>&1; then
    log_err "tmux not found. Install: sudo apt-get install -y tmux"
    return 1
  fi

  mapfile -t hosts < <(read_hosts)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  log "INFO" "Opening tmux broadcast across $total host(s)..."
  log "INFO" "Sync ON by default. Toggle: Ctrl-b :setw synchronize-panes off"

  # We avoid the tmux + bash -c + nested-quoting nightmare by writing one
  # small launcher script per host and pointing tmux at it. This mirrors how
  # ssh_menu already handles the same problem.
  local bdir; bdir="$(mktemp -d --suffix=.lab-bcast)"
  chmod 700 "$bdir"

  # Per-host launcher scripts. `; exec bash -i` keeps the pane open if the
  # ssh dies, so a single failure doesn't tear down the whole session.
  local i=0 line ip func host_script
  declare -a host_scripts=()
  declare -a pane_titles=()
  for line in "${hosts[@]}"; do
    i=$(( i + 1 ))
    IFS=',' read -r ip func <<<"$line"
    ip="$(trim "$ip")"; func="$(trim "$func")"
    host_script="$bdir/host-${i}.sh"
    {
      printf '#!/usr/bin/env bash\n'
      printf 'export SSHPASS=%q\n' "$SSHPASS"
      printf 'printf "\\033]0;%s\\007"\n' "${func:-HOST}"
      printf 'sshpass -e ssh'
      printf ' %q' "${SSH_OPTS[@]}"
      printf ' %q\n' "${username}@${ip}"
      printf 'echo\n'
      printf 'printf "[lab-speed] %s session ended\\n"\n' "${func:-HOST}"
      printf 'exec bash -i\n'
    } >"$host_script"
    chmod 700 "$host_script"
    host_scripts+=("$host_script")
    pane_titles+=("${func:-HOST}")
  done

  # The top-level launcher: builds the tmux session and attaches.
  local tmp_script; tmp_script="$(mktemp --suffix=.sh)"
  chmod 700 "$tmp_script"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -u\n'
    printf 'SESSION=lab-speed-bcast-$$\n'
    printf 'printf "\\033]0;lab-speed broadcast\\007"\n\n'
    printf 'cat <<BANNER\n'
    printf '======================================\n'
    printf ' lab-speed broadcast — %d host(s)\n' "$total"
    printf '======================================\n'
    printf ' Sync is ON by default — type once,\n'
    printf ' hit every host.\n\n'
    printf ' Toggle sync : Ctrl-b :setw synchronize-panes\n'
    printf ' Cycle panes : Ctrl-b o\n'
    printf ' Zoom pane   : Ctrl-b z\n'
    printf ' Detach      : Ctrl-b d\n'
    printf ' Kill all    : Ctrl-b : kill-session\n'
    printf '======================================\n'
    printf 'BANNER\n'
    printf 'sleep 1\n\n'

    # First pane: create the session
    printf 'tmux new-session -d -s "$SESSION" -n hosts bash %q\n' "${host_scripts[0]}"
    printf 'tmux select-pane -t "$SESSION:hosts.0" -T %q\n' "${pane_titles[0]}"

    # Remaining panes: split + tile
    local k
    for (( k=1; k<total; k++ )); do
      printf 'tmux split-window -t "$SESSION:hosts" bash %q\n' "${host_scripts[$k]}"
      printf 'tmux select-pane -T %q\n' "${pane_titles[$k]}"
      printf 'tmux select-layout -t "$SESSION:hosts" tiled >/dev/null\n'
    done

    # Pane border titles, sync, final tile, attach
    printf '\ntmux set -t "$SESSION" pane-border-status top\n'
    printf 'tmux set -t "$SESSION" pane-border-format " #{pane_title} "\n'
    printf 'tmux setw -t "$SESSION:hosts" synchronize-panes on\n'
    printf 'tmux select-layout -t "$SESSION:hosts" tiled >/dev/null\n'
    printf 'tmux attach -t "$SESSION"\n\n'
    printf 'echo\n'
    printf "printf '[lab-speed] broadcast session ended\\\\n'\n"
    printf "read -r -p 'Press Enter to close...' _\n"
    # Clean up the per-host scripts and self
    printf 'rm -rf -- %q\n' "$bdir"
    printf 'rm -f -- %q\n' "$tmp_script"
  } >"$tmp_script"

  if open_ssh_terminal "lab-speed broadcast" "$tmp_script"; then
    log_ok "Opened tmux broadcast in a new terminal ($total panes)."
    return 0
  fi

  # No GUI terminal — run tmux directly in this window
  log "INFO" "No GUI terminal found — running tmux in this window."
  bash "$tmp_script"
}

# ───────────────────────────── Health check ─────────────────────────────────
# Parallel SSH to every host; reports hostname, uptime, free disk on /,
# free mem, Splunk status + version. Useful right after GO! to catch silent
# failures (rsync OK but host otherwise broken).
health_check() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds

  mapfile -t hosts < <(read_hosts_full)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  log "INFO" "Health-checking $total host(s) in parallel..."

  local tmpdir; tmpdir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" RETURN

  # Remote probe — kept POSIX-ish, single line, no heredoc fragility.
  # Output is one CSV line: func,host,uptime,disk_free,mem_free,splunk_status,splunk_ver
  # Any field that can't be determined → "?"
  local remote_cmd
  remote_cmd='
    h=$(hostname -s 2>/dev/null || echo "?");
    up=$(uptime -p 2>/dev/null | sed "s/^up //" || echo "?");
    disk=$(df -h / 2>/dev/null | awk "NR==2 {print \$4}" || echo "?");
    mem=$(free -h 2>/dev/null | awk "/^Mem:/ {print \$7}" || echo "?");
    if pgrep -x splunkd >/dev/null 2>&1; then sp="up"; else sp="down"; fi;
    if [ -x /opt/splunk/bin/splunk ]; then
      sv=$(/opt/splunk/bin/splunk version 2>/dev/null | head -1 | awk "{print \$2}");
    else
      sv="-";
    fi;
    [ -z "$sv" ] && sv="?";
    printf "%s|%s|%s|%s|%s|%s\n" "$h" "$up" "$disk" "$mem" "$sp" "$sv"
  '

  local pids=() line ext_ip int_ip func
  for line in "${hosts[@]}"; do
    IFS=',' read -r ext_ip int_ip func <<<"$line"
    ext_ip="$(trim "$ext_ip")"; int_ip="$(trim "$int_ip")"; func="$(trim "$func")"
    (
      local out
      if out=$(sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${ext_ip}" \
                "$remote_cmd" 2>/dev/null); then
        printf "ok|%s|%s|%s|%s\n" "$func" "$ext_ip" "$int_ip" "$out" >"$tmpdir/${func//\//_}.result"
      else
        printf "fail|%s|%s|%s||||||\n" "$func" "$ext_ip" "$int_ip" >"$tmpdir/${func//\//_}.result"
      fi
    ) >/dev/null 2>&1 &
    pids+=($!)
  done

  shopt -s nullglob
  local done_count=0
  while (( done_count < total )); do
    local result_files=("$tmpdir"/*.result)
    done_count="${#result_files[@]}"
    progress_bar "$done_count" "$total" "checking..."
    sleep 0.25
  done
  shopt -u nullglob
  echo

  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  # Render results table — added INT-IP column between EXT-IP and HOSTNAME
  echo
  printf "  %-8s %-15s %-13s %-12s %-15s %-7s %-7s %-9s %s\n" \
    "FUNC" "EXT-IP" "INT-IP" "HOSTNAME" "UPTIME" "DISK/" "MEM" "SPLUNK" "VER"
  printf "  %-8s %-15s %-13s %-12s %-15s %-7s %-7s %-9s %s\n" \
    "----" "------" "------" "--------" "------" "-----" "---" "------" "---"

  local result_file ok=0 fail=0
  # Sort by function name so output order is stable across runs
  for result_file in $(ls "$tmpdir"/*.result 2>/dev/null | sort); do
    [[ -f "$result_file" ]] || continue
    local raw; raw="$(cat "$result_file")"
    local status func2 ext2 int2 host up disk mem sp sv
    IFS='|' read -r status func2 ext2 int2 host up disk mem sp sv <<<"$raw"

    if [[ "$status" == "ok" ]]; then
      ok=$(( ok + 1 ))
      # Truncate uptime to keep the row tidy
      [[ ${#up} -gt 14 ]] && up="${up:0:13}…"
      # Color splunk status
      local sp_disp="$sp"
      if [[ "$sp" == "up" ]]; then
        sp_disp=$(printf "%b%-7s%b" "$CLR_GRN" "up" "$CLR_RST")
      elif [[ "$sp" == "down" ]]; then
        sp_disp=$(printf "%b%-7s%b" "$CLR_YEL" "down" "$CLR_RST")
      fi
      printf "  %-8s %-15s %-13s %-12s %-15s %-7s %-7s %-9b %s\n" \
        "${func2:-?}" "${ext2:-?}" "${int2:--}" "${host:-?}" "${up:-?}" \
        "${disk:-?}" "${mem:-?}" "$sp_disp" "${sv:-?}"
    else
      fail=$(( fail + 1 ))
      printf "  %-8s %-15s %-13s %b%s%b\n" \
        "${func2:-?}" "${ext2:-?}" "${int2:--}" "$CLR_RED" "UNREACHABLE" "$CLR_RST"
    fi
  done

  echo
  if (( fail == 0 )); then
    log_ok "Health check — ${ok}/${total} hosts reachable."
  else
    log_warn "Health check — ${ok}/${total} OK, ${fail} unreachable."
  fi
}

# ──────────────────────────── Mesh SSH keys ─────────────────────────────────
# Sets up host-to-host SSH key auth. Two modes:
#   hub-and-spoke: one chosen host can SSH to every host (incl. itself)
#   full mesh:     every host can SSH to every host
#
# Note: option 6 sets up laptop→host. This option sets up host→host, which is
# what you want for distributed-Splunk lab work (bundle pushes from the CM,
# diag collection from a SH, etc).
#
# Implementation strategy (avoids any private key leaving the lab):
#   1. SSH to each "source" host (hub or all hosts in mesh mode) and run a
#      remote script that ensures ~/.ssh/id_rsa exists, then prints its public
#      key on stdout. The private key never leaves the host.
#   2. Collect the public keys locally.
#   3. SSH to each "target" host and append the appropriate public key(s) to
#      ~/.ssh/authorized_keys, deduping so re-runs are idempotent.
mesh_ssh_keys() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds

  mapfile -t hosts < <(read_hosts)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  echo
  printf "  %s\n" "Mesh SSH key setup — host-to-host passwordless SSH"
  echo
  printf "  %s\n" "Hosts:"
  local i=0 line ip func
  for line in "${hosts[@]}"; do
    i=$(( i + 1 ))
    IFS=',' read -r ip func <<<"$line"
    ip="$(trim "$ip")"; func="$(trim "$func")"
    printf "  %2d) %-22s %s\n" "$i" "${func:-HOST}" "$ip"
  done

  echo
  printf "  %s\n" "Mode:"
  printf "  %s\n" "  Enter a host number (1-$total) to set up hub-and-spoke from that host"
  printf "  %s\n" "  Enter 'm' for full mesh (every host → every host)"
  printf "  %s\n" "  Enter 'q' to cancel"
  echo
  read -r -p "  Choice: " choice

  [[ "$choice" == "q" || "$choice" == "Q" ]] && { log "INFO" "Cancelled."; return 0; }

  # Determine source hosts (the ones whose keys get distributed)
  local -a src_indexes=()
  if [[ "$choice" == "m" || "$choice" == "M" ]]; then
    log "INFO" "Mode: full mesh — every host will be able to SSH to every host."
    log_warn "This means anyone with shell on any host can reach every other host."
    read -r -p "  Continue? (y/N): " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { log "INFO" "Cancelled."; return 0; }
    for (( i=0; i<total; i++ )); do src_indexes+=("$i"); done
  elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= total )); then
    src_indexes+=("$(( choice - 1 ))")
    IFS=',' read -r ip func <<<"${hosts[$(( choice - 1 ))]}"
    func="$(trim "$func")"
    log "INFO" "Mode: hub-and-spoke from ${func:-HOST} → all ${total} hosts."
  else
    log_warn "Invalid choice."
    return 0
  fi

  # ── Phase 1: ensure each source host has a keypair, collect public keys ──
  local tmpdir; tmpdir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" RETURN

  # Remote script: idempotent keygen + emit pubkey
  # Uses RSA 4096 to match option 6's key style.
  local keygen_cmd
  keygen_cmd='
    mkdir -p ~/.ssh && chmod 700 ~/.ssh;
    if [ ! -f ~/.ssh/id_rsa ]; then
      ssh-keygen -t rsa -b 4096 -N "" -f ~/.ssh/id_rsa -q;
    fi;
    cat ~/.ssh/id_rsa.pub
  '

  log "INFO" "Phase 1/2: generating keys on ${#src_indexes[@]} source host(s)..."
  local idx src_ip src_func pubkey_file pubkey_count=0
  for idx in "${src_indexes[@]}"; do
    IFS=',' read -r src_ip src_func <<<"${hosts[$idx]}"
    src_ip="$(trim "$src_ip")"; src_func="$(trim "$src_func")"
    pubkey_file="$tmpdir/${src_func//\//_}.pub"
    if sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${src_ip}" \
         "$keygen_cmd" >"$pubkey_file" 2>/dev/null && [[ -s "$pubkey_file" ]]; then
      log_ok "Key on ${src_func} (${src_ip})"
      pubkey_count=$(( pubkey_count + 1 ))
    else
      log_warn "${src_func} (${src_ip}): keygen/fetch failed — skipping as source"
      rm -f "$pubkey_file"
    fi
  done

  if (( pubkey_count == 0 )); then
    log_err "No source keys collected — aborting."
    return 1
  fi

  # ── Phase 2: install collected pubkeys on every host (parallel) ──
  log "INFO" "Phase 2/2: installing ${pubkey_count} key(s) on ${total} host(s) in parallel..."

  # Build the combined authorized_keys block once. We'll send it to each host
  # and have a small remote script append-and-dedupe.
  local combined_keys; combined_keys="$(cat "$tmpdir"/*.pub 2>/dev/null)"
  if [[ -z "$combined_keys" ]]; then
    log_err "No public keys to install — aborting."
    return 1
  fi

  # Remote script: append keys, then dedupe authorized_keys in place.
  # We use a heredoc-fed input so keys with special chars are passed safely.
  local install_cmd
  install_cmd='
    mkdir -p ~/.ssh && chmod 700 ~/.ssh;
    touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys;
    cat >> ~/.ssh/authorized_keys;
    # Dedupe in place, preserving order of first occurrence
    awk "!seen[\$0]++" ~/.ssh/authorized_keys > ~/.ssh/authorized_keys.tmp \
      && mv ~/.ssh/authorized_keys.tmp ~/.ssh/authorized_keys \
      && chmod 600 ~/.ssh/authorized_keys
  '

  local pids=() install_ip install_func
  for line in "${hosts[@]}"; do
    IFS=',' read -r install_ip install_func <<<"$line"
    install_ip="$(trim "$install_ip")"; install_func="$(trim "$install_func")"
    (
      if printf "%s\n" "$combined_keys" | \
         sshpass -e ssh "${SSH_OPTS[@]}" "${username}@${install_ip}" \
           "$install_cmd" 2>/dev/null; then
        printf "ok:%s:%s\n"   "$install_func" "$install_ip" >"$tmpdir/${install_func//\//_}.result"
      else
        printf "fail:%s:%s\n" "$install_func" "$install_ip" >"$tmpdir/${install_func//\//_}.result"
      fi
    ) >/dev/null 2>&1 &
    pids+=($!)
  done

  shopt -s nullglob
  local done_count=0
  while (( done_count < total )); do
    local result_files=("$tmpdir"/*.result)
    done_count="${#result_files[@]}"
    progress_bar "$done_count" "$total" "installing..."
    sleep 0.25
  done
  shopt -u nullglob
  echo

  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  local ok=0 fail=0 result_file
  for result_file in "$tmpdir"/*.result; do
    [[ -f "$result_file" ]] || continue
    local result; result="$(cat "$result_file")"
    case "$result" in
      ok:*)   ok=$(( ok + 1 )) ;;
      fail:*) fail=$(( fail + 1 ))
              local fhost; fhost="${result#fail:}"
              log_warn "${fhost%%:*} (${fhost##*:}): install failed" ;;
    esac
  done

  echo
  if (( fail == 0 )); then
    log_ok "Mesh keys installed: ${pubkey_count} source key(s) → ${ok}/${total} hosts."
    if (( ${#src_indexes[@]} == 1 )); then
      IFS=',' read -r src_ip src_func <<<"${hosts[${src_indexes[0]}]}"
      src_func="$(trim "$src_func")"
      log "INFO" "Test: from ${src_func}, run 'ssh ${username}@<other-host-ip>'"
    else
      log "INFO" "Test: ssh between any two hosts should now work without a password."
    fi
  else
    log_warn "Mesh keys: ${ok}/${total} OK, ${fail} failed."
  fi
}

# ──────────────────────────────── Import hosts ──────────────────────────────
# Paste the lab credentials table (from the lab portal webpage) and lab-speed
# parses it into local/hosts.csv. Expected columns (order auto-detected by
# content):
#   URL, external-ip, internal-ip, admin-user, admin-password, ssh-user, status
#
# Function names are derived from the URL host portion (cm1→CM, idx1→IDX1,
# shcd→SHC-Dep, etc). Existing local/hosts.csv and local/credentials.txt are
# backed up to .bak-<timestamp> before being overwritten.
import_hosts() {
  echo
  printf "  %s\n" "Paste the lab table from the portal (tab- or whitespace-separated)."
  printf "  %s\n" "Each line should look something like:"
  printf "  %s\n" "    https://...cm1...  18.219.29.53  10.0.72.87  admin  PWD  sccStudent  Ready"
  printf "  %s\n" "When finished pasting, press Ctrl-D (or just Enter on an empty line)."
  echo

  # Read paste from stdin. We read until EOF; an empty line *also* terminates
  # so users on terminals that don't pass Ctrl-D cleanly can still finish.
  local -a raw_lines=()
  local line empty_count=0
  while IFS= read -r line; do
    if [[ -z "$line" ]]; then
      empty_count=$(( empty_count + 1 ))
      (( empty_count >= 1 && ${#raw_lines[@]} > 0 )) && break
      continue
    fi
    empty_count=0
    raw_lines+=("$line")
  done

  if (( ${#raw_lines[@]} == 0 )); then
    log_warn "No input received."
    return 0
  fi

  # Parse with awk: detect column roles by content, not position.
  # Output: function|external-ip|internal-ip|ssh-user|admin-password
  # (URL is preserved so we can write the host-url column too)
  local tmpdir; tmpdir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" RETURN

  printf "%s\n" "${raw_lines[@]}" >"$tmpdir/raw.txt"

  # Use awk to parse — split on tabs first, fall back to whitespace
  awk '
    function is_ip(s)   { return s ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ }
    function is_url(s)  { return s ~ /^https?:\/\// }
    function is_priv(s) { return s ~ /^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)/ }

    # Derive function name from URL, e.g. ...-cm1.students.splunk.education → CM
    function derive_func(url,    h, suffix, lower, upper) {
      # Pull the host part: strip scheme and path
      sub(/^https?:\/\//, "", url)
      sub(/\/.*$/, "", url)
      # Take the last hyphenated token before the first .
      h = url
      sub(/\..*$/, "", h)
      # h is something like "esi3-911101-12c2d...05d-cm1" — take the last "-XYZ"
      n = split(h, parts, "-")
      suffix = parts[n]
      lower = tolower(suffix)

      # Well-known Splunk lab role mappings — keep these in sync with what
      # the lab portal uses. Anything not in this table falls through to
      # "uppercase the token verbatim" which gives a sensible default
      # (e.g. unknown "foo2" → "FOO2"; user can edit hosts.csv manually).
      if (lower == "cm1")  return "CM"
      if (lower == "cm2")  return "CM2"
      if (lower == "mc1")  return "MC"
      if (lower == "mc2")  return "MC2"
      if (lower == "shcd") return "SHC-Dep"
      if (lower == "lm1")  return "LM"
      if (lower == "dep")  return "Dep"
      return toupper(suffix)
    }

    {
      # Tab-split first; if only one field, fall back to whitespace-split
      n = split($0, f, "\t")
      if (n < 2) {
        # remove leading/trailing whitespace then split on runs of whitespace
        gsub(/^[[:space:]]+|[[:space:]]+$/, "")
        n = split($0, f, /[[:space:]]+/)
      }

      # Trim each field
      for (i=1; i<=n; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", f[i])
      }

      # Skip header-like rows (contain words like "URL", "External", "User"
      # without containing actual IPs)
      has_ip = 0; has_url = 0
      for (i=1; i<=n; i++) {
        if (is_ip(f[i]))  has_ip = 1
        if (is_url(f[i])) has_url = 1
      }
      if (!has_ip || !has_url) next

      # Identify each role.
      # Strategy: use position relative to known anchor tokens (admin for
      # the Splunk-UI user column, Ready for the status column), because
      # the heuristic of "first identifier wins" can swap the SSH user and
      # the password when the password happens to be alphanumeric.
      # The portal table format we expect: URL, ext-ip, int-ip, admin, PWD,
      # ssh-user, Ready.
      url = ""; ext_ip = ""; int_ip = ""; ssh_user = ""; admin_pw = ""

      # Find anchor positions
      admin_idx = 0; ready_idx = 0
      for (i=1; i<=n; i++) {
        if (f[i] == "admin")                       admin_idx = i
        if (f[i] == "Ready" || f[i] == "ready")    ready_idx = i
      }

      # Walk fields once to fill URL and IPs
      for (i=1; i<=n; i++) {
        v = f[i]
        if (is_url(v))                     url = v
        else if (is_ip(v) && is_priv(v))   int_ip = v
        else if (is_ip(v))                 ext_ip = v
      }

      # Password is the cell right after the admin column; ssh-user is the
      # cell right before the Ready column.
      if (admin_idx > 0 && admin_idx + 1 <= n) {
        cand = f[admin_idx + 1]
        if (!is_url(cand) && !is_ip(cand)) admin_pw = cand
      }
      if (ready_idx > 1) {
        cand = f[ready_idx - 1]
        if (!is_url(cand) && !is_ip(cand) && cand != "admin") ssh_user = cand
      }

      # Fallback for non-standard pastes (no admin or Ready anchors):
      # use the old heuristic so we degrade gracefully.
      if (ssh_user == "" || admin_pw == "") {
        for (i=1; i<=n; i++) {
          v = f[i]
          if (is_url(v) || is_ip(v))             continue
          if (v == "admin" || v == "Ready" || v == "ready") continue
          if (ssh_user == "" && v ~ /^[A-Za-z][A-Za-z0-9_]*$/ && length(v) < 32) {
            ssh_user = v
          } else if (admin_pw == "") {
            admin_pw = v
          }
        }
      }

      if (url == "" || ext_ip == "") next

      func_name = derive_func(url)
      printf "%s|%s|%s|%s|%s|%s\n", func_name, url, ext_ip, int_ip, ssh_user, admin_pw
    }
  ' "$tmpdir/raw.txt" >"$tmpdir/parsed.txt"

  local parsed_count; parsed_count=$(wc -l <"$tmpdir/parsed.txt")
  if (( parsed_count == 0 )); then
    log_err "Couldn't parse any host rows from the paste."
    log "INFO" "Expected each row to contain a URL and at least one IP."
    return 1
  fi

  # Preview what we found
  echo
  log_ok "Parsed $parsed_count host row(s):"
  printf "    %-10s %-58s %-15s %s\n" "FUNC" "URL" "EXT-IP" "INT-IP"
  printf "    %-10s %-58s %-15s %s\n" "----" "---" "------" "------"
  local fn url ext_ip int_ip ssh_user admin_pw
  while IFS='|' read -r fn url ext_ip int_ip ssh_user admin_pw; do
    # Truncate long URLs in the preview but keep full string in the CSV
    local url_disp="$url"
    [[ ${#url_disp} -gt 56 ]] && url_disp="${url_disp:0:55}…"
    printf "    %-10s %-58s %-15s %s\n" "$fn" "$url_disp" "$ext_ip" "${int_ip:--}"
  done <"$tmpdir/parsed.txt"

  # Detect SSH user and admin password (use the first row's values; warn if rows differ)
  local first_ssh_user="" first_admin_pw="" ssh_user_consistent=1 admin_pw_consistent=1
  while IFS='|' read -r fn url ext_ip int_ip ssh_user admin_pw; do
    if [[ -z "$first_ssh_user" ]]; then
      first_ssh_user="$ssh_user"; first_admin_pw="$admin_pw"
    else
      [[ "$ssh_user" != "$first_ssh_user" ]] && ssh_user_consistent=0
      [[ "$admin_pw" != "$first_admin_pw" ]] && admin_pw_consistent=0
    fi
  done <"$tmpdir/parsed.txt"

  echo
  if [[ -n "$first_ssh_user" ]] && (( ssh_user_consistent )); then
    log_ok "Detected SSH user: $first_ssh_user"
  elif [[ -n "$first_ssh_user" ]]; then
    log_warn "SSH user varies across rows — using '$first_ssh_user' from the first row."
  fi
  if [[ -n "$first_admin_pw" ]] && (( admin_pw_consistent )); then
    log_ok "Detected lab password (${#first_admin_pw} chars)"
  elif [[ -n "$first_admin_pw" ]]; then
    log_warn "Lab password varies across rows — using the value from the first row."
  fi

  # Confirm before writing
  echo
  read -r -p "  Write to $HOSTS_FILE and update $CREDS_FILE? (y/N): " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { log "INFO" "Cancelled — no files written."; return 0; }

  local ts; ts="$(date +%Y%m%d-%H%M%S)"

  # Back up existing files
  if [[ -f "$HOSTS_FILE" ]]; then
    cp "$HOSTS_FILE" "${HOSTS_FILE}.bak-${ts}"
    log "INFO" "Backed up existing hosts.csv → ${HOSTS_FILE}.bak-${ts}"
  fi
  if [[ -f "$CREDS_FILE" ]]; then
    cp "$CREDS_FILE" "${CREDS_FILE}.bak-${ts}"
    chmod 600 "${CREDS_FILE}.bak-${ts}"
    log "INFO" "Backed up existing credentials.txt → ${CREDS_FILE}.bak-${ts}"
  fi

  # Write the new hosts.csv (matches the existing schema)
  {
    printf "host-url,external-ip,internal-ip,function\n"
    while IFS='|' read -r fn url ext_ip int_ip ssh_user admin_pw; do
      printf "%s,%s,%s,%s\n" "$url" "$ext_ip" "${int_ip:-}" "$fn"
    done <"$tmpdir/parsed.txt"
  } >"$HOSTS_FILE"
  log_ok "Wrote $HOSTS_FILE ($parsed_count host(s))"

  # Write credentials.txt only if we detected a user and password
  if [[ -n "$first_ssh_user" && -n "$first_admin_pw" ]]; then
    {
      printf "# lab-speed credentials (chmod 600) — generated by Import on %s\n" "$(date)"
      printf 'username="%s"\n' "$first_ssh_user"
      printf 'password="%s"\n' "$first_admin_pw"
      printf 'SSHPASS="%s"\n' "$first_admin_pw"
    } >"$CREDS_FILE"
    chmod 600 "$CREDS_FILE"
    log_ok "Wrote $CREDS_FILE"
  else
    log_warn "Could not detect both SSH user and password — $CREDS_FILE not updated."
  fi

  # Record the moment "the servers were listed" — this is when the lab clock
  # starts ticking. Overwrites any previous timestamp; that's intentional —
  # if the user re-imports it's a new lab.
  date +%s >"$LAB_START_FILE"

  echo
  log "INFO" "Import complete. Run option 1 (GO!) to provision the hosts."
}

# ─────────────────────────────────── Retrieve ───────────────────────────────
# Pull files from /tmp/lab-speed/ on selected hosts back to
# local/retrieved/<timestamp>/<func>/.
#
# Selection syntax:
#   a         — all hosts
#   3         — single host
#   3,7,8     — multiple hosts
#   3-5       — range
#   3,7-9,11  — combination
retrieve_files() {
  require_lab_session || return 0
  ensure_hosts
  ensure_creds

  mapfile -t hosts < <(read_hosts_full)
  local total="${#hosts[@]}"
  (( total > 0 )) || die "No hosts found in $HOSTS_FILE"

  echo
  printf "  %s\n" "Retrieve files from /tmp/lab-speed/ on selected hosts:"
  echo
  printf "  %s\n" "  #  Function               External IP      Internal IP"
  printf "  %s\n" "  -  --------               -----------      -----------"
  local i=0 line ext_ip int_ip func
  for line in "${hosts[@]}"; do
    i=$(( i + 1 ))
    IFS=',' read -r ext_ip int_ip func <<<"$line"
    ext_ip="$(trim "$ext_ip")"; int_ip="$(trim "$int_ip")"; func="$(trim "$func")"
    printf "  %2d) %-22s %-16s %s\n" "$i" "${func:-HOST}" "$ext_ip" "${int_ip:--}"
  done
  echo
  printf "  %s\n" "Selection: 'a' for all, comma-separated (3,7), ranges (3-5), or combine (3,7-9)."
  read -r -p "  Hosts to retrieve from (or q): " sel
  [[ "$sel" == "q" || "$sel" == "Q" || -z "$sel" ]] && { log "INFO" "Cancelled."; return 0; }

  # Resolve the selection into a list of host indexes (0-based)
  local -a chosen=()
  if [[ "$sel" == "a" || "$sel" == "A" ]]; then
    for (( i=0; i<total; i++ )); do chosen+=("$i"); done
  else
    # Split on commas, then handle ranges
    local token start end n
    IFS=',' read -ra tokens <<<"$sel"
    for token in "${tokens[@]}"; do
      token="$(trim "$token")"
      [[ -z "$token" ]] && continue
      if [[ "$token" =~ ^[0-9]+-[0-9]+$ ]]; then
        start="${token%-*}"; end="${token#*-}"
        if (( start < 1 || end > total || start > end )); then
          log_warn "Range '$token' out of bounds (1-$total) — skipping."
          continue
        fi
        for (( n=start; n<=end; n++ )); do chosen+=("$(( n - 1 ))"); done
      elif [[ "$token" =~ ^[0-9]+$ ]]; then
        if (( token < 1 || token > total )); then
          log_warn "Host '$token' out of bounds (1-$total) — skipping."
          continue
        fi
        chosen+=("$(( token - 1 ))")
      else
        log_warn "Unrecognised token '$token' — skipping."
      fi
    done
  fi

  if (( ${#chosen[@]} == 0 )); then
    log_warn "No valid hosts selected."
    return 0
  fi

  # Deduplicate while preserving order
  local -a uniq=()
  declare -A seen=()
  for idx in "${chosen[@]}"; do
    if [[ -z "${seen[$idx]:-}" ]]; then
      uniq+=("$idx"); seen[$idx]=1
    fi
  done
  chosen=("${uniq[@]}")

  local chosen_count="${#chosen[@]}"
  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  local dest_root="local/retrieved/$ts"
  mkdir -p "$dest_root"

  log "INFO" "Retrieving from $chosen_count host(s) in parallel → $dest_root/"

  local tmpdir; tmpdir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" RETURN

  # SSH transport for rsync (same options as the rest of the script)
  local ssh_e; ssh_e="ssh"
  for opt in "${SSH_OPTS[@]}"; do
    ssh_e+=" $(printf '%q' "$opt")"
  done

  local pids=() idx
  for idx in "${chosen[@]}"; do
    IFS=',' read -r ext_ip int_ip func <<<"${hosts[$idx]}"
    ext_ip="$(trim "$ext_ip")"; func="$(trim "$func")"
    local safe_func="${func//\//_}"
    safe_func="${safe_func// /_}"
    local dest="$dest_root/${safe_func:-host-$(( idx + 1 ))}"
    mkdir -p "$dest"

    (
      # Trailing slash on the source pulls the *contents* of /tmp/lab-speed/
      # into the dest directory.
      if sshpass -e rsync -a \
           -e "$ssh_e" \
           "${username}@${ext_ip}:$TARGET_DIR/" "$dest/" 2>/dev/null; then
        local count; count=$(find "$dest" -mindepth 1 -type f 2>/dev/null | wc -l)
        printf "ok|%s|%s|%d\n" "$func" "$ext_ip" "$count" >"$tmpdir/${safe_func}.result"
      else
        printf "fail|%s|%s|0\n" "$func" "$ext_ip" >"$tmpdir/${safe_func}.result"
      fi
    ) >/dev/null 2>&1 &
    pids+=($!)
  done

  shopt -s nullglob
  local done_count=0
  while (( done_count < chosen_count )); do
    local result_files=("$tmpdir"/*.result)
    done_count="${#result_files[@]}"
    progress_bar "$done_count" "$chosen_count" "pulling..."
    sleep 0.25
  done
  shopt -u nullglob
  echo

  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done

  # Summarise
  echo
  local ok=0 fail=0 total_files=0 result_file
  for result_file in $(ls "$tmpdir"/*.result 2>/dev/null | sort); do
    [[ -f "$result_file" ]] || continue
    local status fn host_ip nfiles
    IFS='|' read -r status fn host_ip nfiles <<<"$(cat "$result_file")"
    if [[ "$status" == "ok" ]]; then
      ok=$(( ok + 1 ))
      total_files=$(( total_files + nfiles ))
      printf "  %b%-8s%b %s (%d file(s))\n" "$CLR_GRN" "$fn" "$CLR_RST" "$host_ip" "$nfiles"
    else
      fail=$(( fail + 1 ))
      printf "  %b%-8s%b %s — retrieve failed\n" "$CLR_RED" "$fn" "$CLR_RST" "$host_ip"
    fi
  done

  echo
  if (( fail == 0 )); then
    log_ok "Retrieved from $ok/$chosen_count host(s); $total_files file(s) total → $dest_root/"
  else
    log_warn "Retrieved from $ok/$chosen_count OK, $fail failed → $dest_root/"
  fi
}

# ──────────────────────────── Show password ────────────────────────────────
# Displays the lab password on screen for ~10 seconds so the user can copy it
# into the lab portal (or wherever it's needed), then clears the screen and
# returns to the menu. Best-effort: also copies to the OS clipboard if a tool
# is available (xclip / wl-copy / pbcopy).
show_password() {
  require_lab_session || return 0
  ensure_creds   # makes sure SSHPASS is exported into our env

  local pw="${SSHPASS:-}"
  if [[ -z "$pw" ]]; then
    log_warn "No password set (have you run Import yet?)"
    return 1
  fi

  # Try to copy to clipboard — succeed silently, fall back to display-only.
  local clip_status=""
  if   command -v wl-copy >/dev/null 2>&1; then
    printf "%s" "$pw" | wl-copy 2>/dev/null && clip_status="copied to Wayland clipboard"
  elif command -v xclip >/dev/null 2>&1; then
    printf "%s" "$pw" | xclip -selection clipboard 2>/dev/null && clip_status="copied to X clipboard"
  elif command -v pbcopy >/dev/null 2>&1; then
    printf "%s" "$pw" | pbcopy 2>/dev/null && clip_status="copied to macOS clipboard"
  fi

  # Display screen
  clear
  printf '\033]0;lab-speed — show password\007'
  echo
  printf "  %bLab password (hides in 10s):%b\n" "$CLR_YEL" "$CLR_RST"
  echo
  printf "    %b%s%b\n" "$CLR_GRN" "$pw" "$CLR_RST"
  echo
  if [[ -n "$clip_status" ]]; then
    printf "  %b%s — paste with Ctrl-V (or Cmd-V).%b\n" "$CLR_DIM" "$clip_status" "$CLR_RST"
  else
    printf "  %bNo clipboard tool found (xclip / wl-copy / pbcopy) — select & copy by hand.%b\n" "$CLR_DIM" "$CLR_RST"
  fi
  echo

  # Countdown with the option to bail early
  local i
  for (( i=10; i>0; i-- )); do
    printf "\r  %bAuto-clearing in %2ds (press Enter to clear now)...%b" "$CLR_DIM" "$i" "$CLR_RST"
    # -t 1: timeout 1s; -N 1: read exactly 1 char without needing Enter
    if read -r -t 1 -N 1 _; then
      break
    fi
  done

  # Clear the line — header() will redraw the menu after we return
  printf "\r%80s\r" " "
}

# ──────────────────────────────────── Cleanup ───────────────────────────────
cleanup() {
  # Show what would be removed
  local -a to_remove=()
  [[ -f "$CREDS_FILE"     ]] && to_remove+=("$CREDS_FILE")
  [[ -f "$HOSTS_FILE"     ]] && to_remove+=("$HOSTS_FILE")
  [[ -f "$LAB_START_FILE" ]] && to_remove+=("$LAB_START_FILE")

  if (( ${#to_remove[@]} == 0 )); then
    log "INFO" "Nothing to clean up — credentials, hosts list, and lab clock already absent."
    return 0
  fi

  echo
  printf "  %s\n" "Clean up will remove:"
  local f
  for f in "${to_remove[@]}"; do
    printf "    - %s\n" "$f"
  done
  echo
  printf "  %s\n" "This resets the lab session (clock returns to zero, hosts list cleared)."
  printf "  %s\n" "Backups created by Import (.bak-<timestamp>) and any retrieved files in"
  printf "  %s\n" "local/retrieved/ are NOT touched."
  echo
  read -r -p "  Proceed? (y/N): " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { log "INFO" "Cancelled — nothing removed."; return 0; }

  for f in "${to_remove[@]}"; do
    rm -f "$f"
    log_ok "Removed $f"
  done

  # Clear the in-memory creds so subsequent options re-prompt rather than
  # using stale values from the now-deleted file.
  unset SSHPASS username password 2>/dev/null || true
}

# ─────────────────────────────────── Main menu ──────────────────────────────
# Small helper: prints a dim "── label ─────────" section header used in the
# main menu. Keeps the loop body readable.
menu_section() {
  printf "  %b── %s ──────────────────────────%b\n" "$CLR_DIM" "$1" "$CLR_RST"
}

menu() {
  rotate_logs

  while true; do
    header

    menu_section "setup"
    printf "  %s\n" "i) Import hosts from paste"
    printf "  %s\n" "1) GO!         (rsync files to all hosts)"
    echo
    menu_section "connect"
    printf "  %s\n" "2) SSH         (open host session)"
    printf "  %s\n" "3) Broadcast   (tmux all-hosts session)"
    printf "  %s\n" "4) URLs        (list lab web URLs)"
    echo
    menu_section "files"
    printf "  %s\n" "5) RSYNC again (laptop → hosts)"
    printf "  %s\n" "r) Retrieve    (hosts → laptop)"
    echo
    menu_section "keys"
    printf "  %s\n" "6) Install SSH keys  (laptop → host)"
    printf "  %s\n" "m) Mesh SSH keys     (host → host)"
    printf "  %s\n" "p) Show password    (copies to clipboard, hides in 10s)"
    echo
    menu_section "checks"
    printf "  %s\n" "7) Dependency check"
    printf "  %s\n" "8) Health check"
    echo
    printf "  %s\n" "9) Clean up        c) Refresh        q) Quit"
    echo
    printf "  %b%s%b\n" "$CLR_DIM" "$REPO_URL" "$CLR_RST"
    echo
    read -r -p "  Select an option: " opt
    case "$opt" in
      i|I) import_hosts;     read -r -p "  Press Enter to return to menu..." _ ;;
      1)   go_run;           read -r -p "  Press Enter to return to menu..." _ ;;
      2)   ssh_menu;         read -r -p "  Press Enter to return to menu..." _ ;;
      3)   broadcast_tmux;   read -r -p "  Press Enter to return to menu..." _ ;;
      4)   list_urls;        read -r -p "  Press Enter to return to menu..." _ ;;
      5)   rsync_only;       read -r -p "  Press Enter to return to menu..." _ ;;
      r|R) retrieve_files;   read -r -p "  Press Enter to return to menu..." _ ;;
      6)   install_ssh_keys; read -r -p "  Press Enter to return to menu..." _ ;;
      m|M) mesh_ssh_keys;    read -r -p "  Press Enter to return to menu..." _ ;;
      p|P) show_password ;;  # no "Press Enter" — already has its own pause
      7)   ensure_hosts; ensure_creds; check_deps
                             read -r -p "  Press Enter to return to menu..." _ ;;
      8)   health_check;     read -r -p "  Press Enter to return to menu..." _ ;;
      9)   cleanup;          read -r -p "  Press Enter to return to menu..." _ ;;
      c|C) ;;  # no-op — menu loop redraws header() on next iteration
      q|Q) exit 0 ;;
      *) log_warn "Invalid option"; sleep 0.5 ;;
    esac
  done
}

